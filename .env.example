# PROJECT SENTINEL - environment configuration (copy to .env)

# --- Dashboard / control-plane API ---
SENTINEL_API_HOST=127.0.0.1
SENTINEL_API_PORT=8443
# JWT signing secret. Leave unset to auto-generate and persist under data/secrets.
# SENTINEL_API_JWT_SECRET=
SENTINEL_API_ACCESS_TOKEN_TTL_MINUTES=30
SENTINEL_API_REFRESH_TOKEN_TTL_DAYS=14
SENTINEL_API_MAX_FAILED_LOGINS=5
SENTINEL_API_LOCKOUT_MINUTES=15
SENTINEL_API_RATE_LIMIT_PER_MINUTE=300
SENTINEL_API_LOGIN_RATE_LIMIT_PER_MINUTE=10

# First-run admin bootstrap (only used when no users exist yet).
SENTINEL_ADMIN_USER=admin
SENTINEL_ADMIN_PASSWORD=change-me-now-please

# TLS (recommended in production).
# SENTINEL_API_TLS_CERTFILE=/etc/sentinel/tls/fullchain.pem
# SENTINEL_API_TLS_KEYFILE=/etc/sentinel/tls/privkey.pem

# --- Agent ---
SENTINEL_DATA_DIR=./data
SENTINEL_CONFIG=./config/sentinel.yaml
SENTINEL_LOG_LEVEL=INFO
# PostgreSQL (optional, enterprise): overrides the default local SQLite database.
# SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:password@localhost:5432/sentinel

# --- Docker compose ---
SENTINEL_WATCH_DIR=./sandbox
# POSTGRES_PASSWORD=change-me
